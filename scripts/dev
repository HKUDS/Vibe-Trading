#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${VIBE_DEV_STATE_DIR:-$ROOT/.vibe-dev}"
LOG_DIR="$STATE_DIR/logs"
PID_DIR="$STATE_DIR/pids"

BACKEND_HOST="${VIBE_BACKEND_HOST:-127.0.0.1}"
BACKEND_PORT="${VIBE_BACKEND_PORT:-8899}"
FRONTEND_HOST="${VIBE_FRONTEND_HOST:-127.0.0.1}"
FRONTEND_PORT="${VIBE_FRONTEND_PORT:-5899}"

# Keep runtime state writable in the project workspace. This is especially
# important on Windows when the shell/sandbox account can read but cannot
# create subdirectories below the user's home directory. Respect an explicit
# override so normal installations can continue using their own state root.
if [[ -n "${VIBE_TRADING_HOME:-}" ]]; then
  RUNTIME_HOME="$VIBE_TRADING_HOME"
elif command -v cygpath >/dev/null 2>&1; then
  RUNTIME_HOME="$(cygpath -w "$ROOT/.vibe-trading")"
else
  RUNTIME_HOME="$ROOT/.vibe-trading"
fi
if [[ -n "${PYTHON:-}" ]]; then
  PYTHON_BIN="$PYTHON"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON_BIN="$ROOT/.venv/bin/python"
elif [[ -x "$ROOT/.venv/Scripts/python.exe" ]]; then
  PYTHON_BIN="$ROOT/.venv/Scripts/python.exe"
elif [[ -x "$ROOT/agent/.venv/bin/python" ]]; then
  PYTHON_BIN="$ROOT/agent/.venv/bin/python"
elif [[ -x "$ROOT/agent/.venv/Scripts/python.exe" ]]; then
  PYTHON_BIN="$ROOT/agent/.venv/Scripts/python.exe"
else
  PYTHON_BIN="python3"
fi

mkdir -p "$LOG_DIR" "$PID_DIR"

usage() {
  cat <<USAGE
Usage: scripts/dev <command>

Commands:
  up                 Start backend and frontend dev servers
  stop               Stop dev servers started by this script
  restart [service]  Restart backend, frontend, or all services
  status             Show process status and URLs
  logs [service]     Tail logs for backend, frontend, or all
  open               Open the frontend in the default browser
  urls               Print local dev URLs

Environment:
  VIBE_BACKEND_PORT   Backend port (default: 8899)
  VIBE_FRONTEND_PORT  Frontend port (default: 5899)
  VIBE_TRADING_HOME   Runtime state directory (default: project/.vibe-trading)
  PYTHON              Python binary (default: local .venv, then python3)
USAGE
}

pid_file() {
  printf "%s/%s.pid" "$PID_DIR" "$1"
}

log_file() {
  printf "%s/%s.log" "$LOG_DIR" "$1"
}

is_running() {
  local service="$1"
  local file
  file="$(pid_file "$service")"
  [[ -f "$file" ]] || return 1
  local pid
  pid="$(cat "$file")"
  if kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  # Git Bash's kill(0) can report a live native Windows process as absent.
  # Use the Windows process table as a fallback during startup and shutdown.
  if command -v tasklist.exe >/dev/null 2>&1; then
    tasklist.exe //FI "PID eq $pid" 2>/dev/null | grep -Eq "[[:space:]]$pid[[:space:]]"
    return $?
  fi
  return 1
}

start_service() {
  local service="$1"
  shift
  if is_running "$service"; then
    printf "%s already running (pid %s)\n" "$service" "$(cat "$(pid_file "$service")")"
    return
  fi

  printf "starting %s...\n" "$service"
  "$PYTHON_BIN" - "$(log_file "$service")" "$(pid_file "$service")" "$@" <<'PY'
import subprocess
import sys
import os

log_path = sys.argv[1]
pid_path = sys.argv[2]
cmd = sys.argv[3:]

# On Windows Git Bash, launching through the `env` executable creates a
# short-lived wrapper process. Track the actual Python/Uvicorn process instead
# so the health wait does not report a false early exit.
proc_env = None
if cmd and cmd[0] == "env":
    proc_env = os.environ.copy()
    cmd = cmd[1:]
    while cmd and "=" in cmd[0] and not cmd[0].startswith("-"):
        key, value = cmd.pop(0).split("=", 1)
        proc_env[key] = value

log = open(log_path, "ab", buffering=0)
proc = subprocess.Popen(
    cmd,
    env=proc_env,
    stdin=subprocess.DEVNULL,
    stdout=log,
    stderr=subprocess.STDOUT,
    start_new_session=True,
    close_fds=True,
)
with open(pid_path, "w", encoding="utf-8") as fh:
    fh.write(str(proc.pid))
PY
  printf "%s pid %s, log %s\n" "$service" "$(cat "$(pid_file "$service")")" "$(log_file "$service")"
}

stop_service() {
  local service="$1"
  local file
  file="$(pid_file "$service")"
  if ! [[ -f "$file" ]]; then
    printf "%s not started by scripts/dev\n" "$service"
    return
  fi

  local pid
  pid="$(cat "$file")"
  if kill -0 "$pid" 2>/dev/null; then
    printf "stopping %s (pid %s)...\n" "$service" "$pid"
    kill -TERM "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    sleep 0.5
    kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$file"
}

port_pids() {
  local port="$1"
  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command "\$ErrorActionPreference = 'SilentlyContinue'; Get-NetTCPConnection -State Listen -LocalPort $port | Select-Object -ExpandProperty OwningProcess" 2>/dev/null \
      | tr -d '\r' \
      | awk '/^[0-9]+$/ { print }' \
      | sort -u
    return
  fi
  if command -v netstat >/dev/null 2>&1; then
    netstat -ano -p tcp 2>/dev/null \
      | awk -v port=":$port" '$1 == "TCP" && $2 ~ (port "$") && ($4 == "LISTENING" || $4 == "LISTEN") { print $5 }' \
      | sort -u
  fi
}

stop_port_processes() {
  local service="$1"
  local port="$2"
  local pid
  while read -r pid; do
    [[ -n "$pid" && "$pid" != "0" && "$pid" != "$$" ]] || continue
    printf "stopping %s process on port %s (pid %s)...\n" "$service" "$port" "$pid"
    if command -v taskkill.exe >/dev/null 2>&1; then
      taskkill.exe //PID "$pid" //T //F >/dev/null 2>&1 || true
    else
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.5
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done < <(port_pids "$port")
}

stop_for_restart() {
  local service="$1"
  local port="$2"
  stop_service "$service"
  stop_port_processes "$service" "$port"
  # Give Windows a moment to release the socket before starting the replacement.
  for ((i = 1; i <= 20; i++)); do
    if ! port_pids "$port" | grep -q .; then
      return 0
    fi
    sleep 0.25
  done
  printf "%s port %s is still occupied; cannot restart it\n" "$service" "$port" >&2
  return 1
}

url_ok() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 "$url" >/dev/null 2>&1
  else
    "$PYTHON_BIN" - "$url" >/dev/null 2>&1 <<'PY'
import sys
import urllib.request

urllib.request.urlopen(sys.argv[1], timeout=2).read(1)
PY
  fi
}

wait_for_url() {
  local service="$1"
  local url="$2"
  local attempts="${3:-30}"

  printf "waiting for %s at %s" "$service" "$url"
  for ((i = 1; i <= attempts; i++)); do
    if url_ok "$url"; then
      printf " ready\n"
      return 0
    fi
    # Git Bash cannot reliably inspect native Windows PIDs, so rely on the
    # health URL there and reserve early-exit detection for POSIX shells.
    if [[ "${OSTYPE:-}" != msys* && "${OSTYPE:-}" != mingw* && "${OSTYPE:-}" != cygwin* ]] && ! is_running "$service"; then
      # Native Windows services launched from Git Bash can take a few seconds
      # to appear in the process table even after their child has started.
      # Give preflight/startup time to bind before declaring an early exit.
      if (( i < 10 )); then
        printf "."
        sleep 1
        continue
      fi
      printf "\n%s exited early; see %s\n" "$service" "$(log_file "$service")" >&2
      return 1
    fi
    printf "."
    sleep 1
  done
  printf "\n%s not ready after %ss; see %s\n" "$service" "$attempts" "$(log_file "$service")" >&2
  return 1
}

service_url() {
  case "$1" in
    backend) printf "http://127.0.0.1:%s/health" "$BACKEND_PORT" ;;
    frontend) printf "http://127.0.0.1:%s" "$FRONTEND_PORT" ;;
    *) return 2 ;;
  esac
}

start_backend() {
  if ! is_running backend && url_ok "$(service_url backend)"; then
    rm -f "$(pid_file backend)"
    printf "backend already reachable at %s (external)\n" "$(service_url backend)"
    return
  fi
  start_service backend env VIBE_TRADING_HOME="$RUNTIME_HOME" PYTHONPATH="$ROOT/agent" "$PYTHON_BIN" -c 'import cli, sys; raise SystemExit(cli.main(sys.argv[1:]))' serve \
    --host "$BACKEND_HOST" \
    --port "$BACKEND_PORT"
}

start_frontend() {
  if ! is_running frontend && url_ok "$(service_url frontend)"; then
    rm -f "$(pid_file frontend)"
    printf "frontend already reachable at %s (external)\n" "$(service_url frontend)"
    return
  fi
  start_service frontend bash -lc '
    set -euo pipefail
    cd "$1"
    # A partially-installed node_modules directory can retain a Vite shim while
    # the package target is missing. Resolve the package that npm will execute,
    # not just the presence of a .bin file.
    if ! node -e "require.resolve('vite/package.json')" >/dev/null 2>&1; then
      npm install
    fi
    export VITE_API_URL="${VITE_API_URL:-http://127.0.0.1:$4}"
    exec npm run dev -- --host "$2" --port "$3"
  ' bash "$ROOT/frontend" "$FRONTEND_HOST" "$FRONTEND_PORT" "$BACKEND_PORT"
}

cmd_up() {
  start_backend
  start_frontend
  if ! wait_for_url backend "$(service_url backend)" 30 || \
     ! wait_for_url frontend "$(service_url frontend)" 30; then
    cmd_stop
    exit 1
  fi
  cmd_urls
}

cmd_stop() {
  stop_service frontend
  stop_service backend
}

cmd_restart() {
  local service="${1:-all}"
  case "$service" in
    backend)
      stop_for_restart backend "$BACKEND_PORT"
      start_backend
      wait_for_url backend "$(service_url backend)" 30
      ;;
    frontend)
      stop_for_restart frontend "$FRONTEND_PORT"
      start_frontend
      wait_for_url frontend "$(service_url frontend)" 30
      ;;
    all)
      stop_for_restart frontend "$FRONTEND_PORT"
      stop_for_restart backend "$BACKEND_PORT"
      cmd_up
      ;;
    *)
      printf "unknown service: %s\n" "$service" >&2
      exit 2
      ;;
  esac
}

cmd_status() {
  for service in backend frontend; do
    if is_running "$service"; then
      printf "%-8s running pid=%s log=%s\n" "$service" "$(cat "$(pid_file "$service")")" "$(log_file "$service")"
    elif url_ok "$(service_url "$service")"; then
      printf "%-8s reachable external url=%s\n" "$service" "$(service_url "$service")"
    else
      printf "%-8s stopped\n" "$service"
    fi
  done
  cmd_urls
}

cmd_logs() {
  local service="${1:-all}"
  case "$service" in
    backend|frontend)
      touch "$(log_file "$service")"
      tail -f "$(log_file "$service")"
      ;;
    all)
      touch "$(log_file backend)" "$(log_file frontend)"
      tail -f "$(log_file backend)" "$(log_file frontend)"
      ;;
    *)
      printf "unknown service: %s\n" "$service" >&2
      exit 2
      ;;
  esac
}

cmd_open() {
  local url="http://127.0.0.1:$FRONTEND_PORT"
  if command -v open >/dev/null 2>&1; then
    open "$url"
  else
    printf "%s\n" "$url"
  fi
}

cmd_urls() {
  cat <<URLS
Frontend: http://127.0.0.1:$FRONTEND_PORT
Backend:  http://127.0.0.1:$BACKEND_PORT
API docs: http://127.0.0.1:$BACKEND_PORT/docs
URLS
}

case "${1:-}" in
  up) cmd_up ;;
  stop) cmd_stop ;;
  restart) shift; cmd_restart "${1:-all}" ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "${1:-all}" ;;
  open) cmd_open ;;
  urls) cmd_urls ;;
  -h|--help|help|"") usage ;;
  *)
    printf "unknown command: %s\n\n" "$1" >&2
    usage >&2
    exit 2
    ;;
esac
